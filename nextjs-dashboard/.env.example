# ─── Next Auth ───────────────────────────────────────────────────────────────
# openssl rand -base64 32 로 생성
AUTH_SECRET=

# ─── 소셜 로그인 ─────────────────────────────────────────────────────────────
# Google Cloud Console → API & Services → Credentials
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Naver Developers → 애플리케이션 등록
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# Kakao Developers → 내 애플리케이션
KAKAO_CLIENT_ID=
KAKAO_CLIENT_SECRET=

# ─── 토스페이먼츠 ────────────────────────────────────────────────────────────
# https://developers.tosspayments.com/ → 개발자 도구 → API 키
NEXT_PUBLIC_TOSS_CLIENT_KEY=test_ck_...
TOSS_SECRET_KEY=test_sk_...

# ─── 데이터베이스 (Supabase) ─────────────────────────────────────────────────
# https://supabase.com/ → 프로젝트 설정 → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI (CMS 어드민 — 기사 초안 생성, 유사도 측정) ──────────────────────────
# https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ─── 앱 URL ──────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# 프로덕션: https://iusm.co.kr
NEXT_PUBLIC_SITE_URL=https://iusm.co.kr

# ─── RSS 동기화 (NSP/ND소프트 통합CMS) ──────────────────────────────────────
# ND소프트로부터 RSS 피드 URL 수령 후 설정
CMS_RSS_FEED_URL=

# Vercel Cron 보안 시크릿 (openssl rand -base64 32)
# Vercel 대시보드 Settings → Environment Variables에 설정
CRON_SECRET=

# ─── SEO 서치콘솔 인증 ───────────────────────────────────────────────────────
# Google Search Console → 설정 → 소유권 확인 → HTML 태그 content 값
GOOGLE_SITE_VERIFICATION=
# 네이버 서치어드바이저 → 사이트 추가 → HTML 태그 content 값
NAVER_SITE_VERIFICATION=
# Bing Webmaster Tools → 사이트 추가 → HTML 메타태그 content 값
BING_SITE_VERIFICATION=

# ─── Google AdSense ──────────────────────────────────────────────────────────
# https://www.google.com/adsense → 사이트 승인 후 게시자 ID
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# 광고 단위(슬롯) ID — AdSense 대시보드 → 광고 → 광고 단위별
NEXT_PUBLIC_ADSENSE_SLOT_HOME_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_HOME_MAIN=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_ARTICLE=
